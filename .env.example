NODE_ENV=development
PORT=4750
DATABASE_URL=postgres://spendlens:spendlens@localhost:5432/spendlens
# Separate database for tests, so tests never touch development data
TEST_DATABASE_URL=postgres://spendlens:spendlens@localhost:5432/spendlens_test
CORS_ORIGIN=http://localhost:5173
# At least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-change-me-change-me-change-me
JWT_EXPIRES_IN=1h

# AI analyst: free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Login protection: failed attempts per IP+email pair and in total per IP address (per 15 minutes)
AUTH_LOGIN_LIMIT=5
AUTH_IP_LIMIT=30
# Number of reverse proxies in front of the server (0 = directly exposed; Docker Compose sets 1)
TRUST_PROXY_HOPS=0
